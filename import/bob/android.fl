class Android {
	static proto require(component: str) -> none
	static proto _get_ndk(toolchain: Toolchain, version: str, api_level: int) -> none

	static fn get_ndk(version: str, api_level: int) -> Toolchain {
		let toolchain = Toolchain()
		Android._get_ndk(toolchain, version, api_level)
		return toolchain
	}

	static proto glue() -> str
}

